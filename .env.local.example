# Turso (libSQL). Leave empty to use a local SQLite file at ./local.db.
# Production: get values from https://turso.tech/ → your database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# iron-session encryption key. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
